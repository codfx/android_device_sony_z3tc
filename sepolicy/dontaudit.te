# Denials that are kept (access stays denied) but not logged, each checked to have no functional effect.

# Sensors HAL probes persist.debug.* (debug-only properties).
dontaudit hal_sensors_default persist_debug_prop:file { read open getattr map };

# Sony TA daemon (tad_static/taimport): MAC addresses and other TA data import correctly without these (Wi-Fi and
# Bluetooth keep their Sony 40:b8:37 addresses). Setting ro.adb.secure from TA must stay denied.
dontaudit tad self:capability dac_override;
dontaudit tad build_prop:property_service set;
dontaudit tad default_prop:file { read open getattr map };

# rild touches /data/misc/radio/dummy_file (radio_core_data_file, a core /data type that vendor domains may never
# access). Calls, SMS and mobile data work without it.
dontaudit rild radio_core_data_file:file { read write open getattr };

# hwcomposer and gralloc look up further display properties that are not set on this device (every set property
# they read is vendor_display_prop, see property_contexts; the composer uses MDP overlays); unset ones fall back to
# default_prop, and their built-in defaults apply.
dontaudit { hal_graphics_composer_default hal_graphics_allocator_default } default_prop:file { read open getattr map };
