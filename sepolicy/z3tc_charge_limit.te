# Battery charge limiter (/vendor/bin/z3tc_charge_limit.sh)
type z3tc_charge_limit, domain;
type z3tc_charge_limit_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(z3tc_charge_limit)

# The script and the vendor toybox/toolbox it runs (cat, sleep, log, getprop)
allow z3tc_charge_limit vendor_shell_exec:file rx_file_perms;
allow z3tc_charge_limit vendor_toolbox_exec:file rx_file_perms;

# Charger state, and the driver's limiter controls (battery/enable_llk, llk_socmax, llk_socmin)
r_dir_file(z3tc_charge_limit, sysfs_usb_supply)
allow z3tc_charge_limit sysfs_battery_supply:dir r_dir_perms;
allow z3tc_charge_limit sysfs_battery_supply:file rw_file_perms;

get_prop(z3tc_charge_limit, vendor_z3tc_charge_prop)
