# Workaround (3.4 kernel, no fs-verity): Android 12 system_server aborts on APEX
# system-server jars compiled into /data/dalvik-cache ("Executing untrusted code").
# odrefresh output can't be verified without fs-verity, so remove them on every boot.
service z3tc_clean_sscache /system/bin/sh -c "rm -f /data/dalvik-cache/arm/apex@*"
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

on post-fs-data
    exec_start z3tc_clean_sscache

# Same cleanup when zygote restarts (system_server crash / soft reboot): otherwise
# the restarted system_server finds the previous boot's dalvik-cache odex for the
# APEX system-server jars and aborts with "Executing untrusted code" in a loop.
# init sets this state as soon as zygote dies, before it is started again.
on property:init.svc.zygote=restarting
    exec_start z3tc_clean_sscache
    # Keep the device awake while the framework restarts: system_server's wakelocks die
    # with it, and zygote's "onrestart write /sys/power/state on" is rejected by this
    # kernel, so with the screen off system_suspend would suspend the device in the middle
    # of the restart (restarts took 15-25 min, mostly asleep). Kernel wakelock with a
    # 5 min timeout: no release needed, and it can't keep the device awake forever.
    write /sys/power/wake_lock "z3tc_zygote_restart 300000000000"

# Same for the Wi-Fi HAL alone (it crashed / was killed, init restarts it): Wi-Fi recovery holds no
# wakelock, so with the screen off the device kept suspending and Wi-Fi stayed down for 8-16+ min.
# 2 min kernel wakelock, released automatically.
on property:init.svc.vendor.wifi_hal_legacy=restarting
    write /sys/power/wake_lock "z3tc_wifihal_restart 120000000000"

# No mpdecision, all CPUs online. Bringing a CPU online while its cpufreq policy is being changed resets this
# SoC (PS_HOLD drop): mpdecision hotplugs 40-60 times a minute under load and its perf locks raise the min
# frequency on every launch and touch. The power HAL applies the boosts itself through sysfs instead.
# Triggered by mpdecision's own service state, so it works however and whenever init.qcom.power.rc starts it
# (its vendor.post_boot.parsed trigger needs a property vendor_init may not set under enforcing SELinux).
# msm_thermal core control stays on (offlines cpu1-3 only at 80 C as a last resort).
on property:init.svc.mpdecision=running
    stop mpdecision
    write /sys/devices/system/cpu/cpu1/online 1
    write /sys/devices/system/cpu/cpu2/online 1
    write /sys/devices/system/cpu/cpu3/online 1

# The power HAL (user system) applies the display-off / video governor values itself. Not "on boot": the
# interactive governor nodes only exist after init.qcom.power.rc's enable-low-power action (triggered from boot).
on property:sys.boot_completed=1
    chown system system /sys/devices/system/cpu/cpufreq/interactive/timer_rate
    chown system system /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load
    chown system system /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq
    chown system system /sys/devices/system/cpu/cpufreq/interactive/io_is_busy
    chown system system /sys/module/cpu_boost/parameters/sync_threshold
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/timer_rate
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/io_is_busy
    chmod 0664 /sys/module/cpu_boost/parameters/sync_threshold
