<!-- Text styles for the widget, flat (no shadows) in a Pixel-like look: Light = pale text for dark wallpapers,
     Dark = dark text for wallpapers that support dark text. Colours come from the Android 12 dynamic (wallpaper)
     palette. -->
<resources>
    <style name="Clock">
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">90sp</item>
    </style>
    <style name="Clock.Light">
        <item name="android:textColor">@android:color/system_accent1_100</item>
    </style>
    <style name="Clock.Dark">
        <item name="android:textColor">@android:color/system_accent1_800</item>
    </style>

    <style name="Glance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">19sp</item>
    </style>
    <style name="Glance.Light">
        <item name="android:textColor">@android:color/system_neutral1_10</item>
    </style>
    <style name="Glance.Dark">
        <item name="android:textColor">@android:color/system_neutral1_900</item>
    </style>

    <style name="Event">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Event.Light">
        <item name="android:textColor">@android:color/system_neutral1_50</item>
    </style>
    <style name="Event.Dark">
        <item name="android:textColor">@android:color/system_neutral1_800</item>
    </style>

    <!-- Settings screen -->
    <style name="SettingsHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
        <item name="android:textColor">?android:attr/colorAccent</item>
    </style>
    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">?android:attr/textAppearanceListItem</item>
    </style>
</resources>
