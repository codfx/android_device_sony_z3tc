# storaged reads the eMMC's I/O counters (/sys/block/mmcblk0/stat) for diskstats. A genfs label for that file
# does not take on this 3.4 kernel (the block device's sysfs entries predate the policy load), so it stays
# plain sysfs; the counters are diagnostics only, so the read stays denied and unlogged.
dontaudit storaged sysfs:file { read open getattr };
